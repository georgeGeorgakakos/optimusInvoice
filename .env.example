# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:optimus123@localhost:3306/invoice_automation"

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-character-random-secret-here"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ── VLM Service ───────────────────────────────────────────────────────────────
# Docker container running Surya OCR + Qwen2.5-3B (started by deploySolutionLocal.ps1)
VLM_SERVICE_URL="http://localhost:8300"

# OCR engine: surya | got_ocr2 | olmocr | qwen_vl | auto
# "surya" = Surya OCR + Qwen2.5-3B semantic extraction (recommended for CPU)
# DB value takes priority — set via Configuration page or seeded by deploy script
VLM_ENGINE=surya

# Optional: override Qwen inference timeout (default 300000ms = 5 min)
# VLM_TIMEOUT=300000

# ── ERP credentials ───────────────────────────────────────────────────────────
# Configured inside the app at http://localhost:3000/configuration
# (stored encrypted in database — not in .env)
